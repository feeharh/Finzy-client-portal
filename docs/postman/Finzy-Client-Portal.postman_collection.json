          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Sarah\",\n  \"lastName\": \"Johnson\",\n  \"email\": \"sarah@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"whatsappNumber\": \"+1234567890\",\n  \"preferredCommunicationMethod\": \"WHATSAPP\",\n  \"notes\": null\n}"
            },
            "url": "{{baseUrl}}/admin/customers",
            "description": "Phase 3."
