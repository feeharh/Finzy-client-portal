        {
          "name": "Get Customer History",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/customers/{{customerId}}/history",
            "description": "Phase 3."
          },
          "response": []
        },
        {
          "name": "Generate Portal Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.portalUrl) {",
                  "        const parts = json.portalUrl.split('/portal/');",
                  "        if (parts[1]) pm.environment.set('portalToken', parts[1]);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/customers/{{customerId}}/access-tokens",
            "description": "Phase 3. Auto-sets portalToken env var."
          },
          "response": []
        },
        {
          "name": "Revoke Portal Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/customers/{{customerId}}/access-tokens/{{tokenId}}/revoke",
            "description": "Phase 3."
          },
          "response": []
        }
      ]
    },
