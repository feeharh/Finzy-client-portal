            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Sarah\",\n  \"lastName\": \"Johnson\",\n  \"email\": \"sarah.updated@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"whatsappNumber\": \"+1234567890\",\n  \"preferredCommunicationMethod\": \"WHATSAPP\",\n  \"notes\": \"VIP customer\"\n}"
            },
