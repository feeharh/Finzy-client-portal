{
  "info": {
    "_postman_id": "finzy-client-portal-api",
    "name": "Finzy Client Portal API",
    "description": "REST API collection for the Finzy Client Portal.\n\n## Setup\n1. Import `Finzy-Client-Portal.postman_environment.json`\n2. Select the **Finzy Client Portal — Local** environment\n3. Start backend: `cd backend && mvn spring-boot:run`\n4. Start Docker Postgres: `cd infrastructure && docker compose up -d`\n\n## Auth\n- **Public:** no auth\n- **Portal:** set `portalToken` env var (auto-set after Submit Appointment when implemented)\n- **Admin:** run **Login** first — Postman stores the session cookie automatically\n\n## Status\nPhase 1: only **Health Check** is live. Other requests are ready for Phase 2–5 implementation.\n\nSee [api-spec.md](../api-spec.md) for full documentation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Phase 1 — implemented. Returns service status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Public",
      "description": "No authentication required.",
      "item": [
        {
          "name": "Submit Appointment (Shopify shape)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.appointmentId) {",
                  "        pm.environment.set('appointmentId', json.appointmentId);",
                  "    }",
                  "    if (json.portalUrl) {",
                  "        const parts = json.portalUrl.split('/portal/');",
                  "        if (parts[1]) pm.environment.set('portalToken', parts[1]);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"firstName\": \"Sarah\",\n    \"lastName\": \"Johnson\",\n    \"email\": \"sarah@example.com\",\n    \"phoneNumber\": \"+1234567890\",\n    \"whatsappNumber\": null,\n    \"preferredCommunicationMethod\": null\n  },\n  \"appointment\": {\n    \"appointmentType\": \"ALTERATION_CONSULTATION\",\n    \"preferredStartAt\": null,\n    \"preferredCompletionDate\": \"2026-09-15\",\n    \"serviceDescription\": null,\n    \"rushServiceRequested\": false,\n    \"customerNotes\": null\n  },\n  \"garments\": [\n    {\n      \"garmentType\": \"DRESS\",\n      \"description\": null,\n      \"color\": null,\n      \"brand\": null,\n      \"sizeLabel\": null,\n      \"customerNotes\": \"Need 1 inch hem, bringing shoes for length reference\",\n      \"alterations\": [\n        {\n          \"alterationType\": \"HEMMING\",\n          \"description\": null\n        }\n      ],\n      \"fileAssetIds\": []\n    }\n  ],\n  \"policyAgreements\": [\n    {\n      \"policyName\": \"Finzy Alterations Policies & Terms\",\n      \"policyVersion\": \"1.0\",\n      \"agreed\": true\n    },\n    {\n      \"policyName\": \"Garment Inspection Acknowledgement\",\n      \"policyVersion\": \"1.0\",\n      \"agreed\": true\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/public/appointments",
            "description": "Option B request shape. Matches Shopify form fields. Phase 3."
          },
          "response": []
        },
        {
          "name": "Submit Appointment (multi-garment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"firstName\": \"Sarah\",\n    \"lastName\": \"Johnson\",\n    \"email\": \"sarah@example.com\",\n    \"phoneNumber\": \"+1234567890\",\n    \"whatsappNumber\": \"+1234567890\",\n    \"preferredCommunicationMethod\": \"WHATSAPP\"\n  },\n  \"appointment\": {\n    \"appointmentType\": \"GARMENT_DROP_OFF\",\n    \"preferredStartAt\": \"2026-08-15T14:00:00Z\",\n    \"preferredCompletionDate\": \"2026-09-01\",\n    \"serviceDescription\": \"Two dresses for hemming\",\n    \"rushServiceRequested\": true,\n    \"customerNotes\": \"Need both before wedding on Sept 5\"\n  },\n  \"garments\": [\n    {\n      \"garmentType\": \"DRESS\",\n      \"description\": \"Blue midi dress\",\n      \"color\": \"Navy\",\n      \"customerNotes\": \"1 inch hem\",\n      \"alterations\": [{ \"alterationType\": \"HEMMING\", \"description\": \"1 inch hem\" }],\n      \"fileAssetIds\": []\n    },\n    {\n      \"garmentType\": \"WEDDING_DRESS\",\n      \"description\": \"Ivory lace gown\",\n      \"color\": \"Ivory\",\n      \"customerNotes\": \"Bustle needed\",\n      \"alterations\": [{ \"alterationType\": \"ADD_BUSTLE\", \"description\": \"American bustle\" }],\n      \"fileAssetIds\": []\n    }\n  ],\n  \"policyAgreements\": [\n    { \"policyName\": \"Finzy Alterations Policies & Terms\", \"policyVersion\": \"1.0\", \"agreed\": true },\n    { \"policyName\": \"Garment Inspection Acknowledgement\", \"policyVersion\": \"1.0\", \"agreed\": true }\n  ]\n}"
            },
            "url": "{{baseUrl}}/public/appointments",
            "description": "Portal /book form with multiple garments. Phase 3."
          },
          "response": []
        },
        {
          "name": "List Appointment Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/public/appointment-types",
            "description": "Phase 3."
          },
          "response": []
        },
        {
          "name": "List Policies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/public/policies",
            "description": "Phase 3."
          },
          "response": []
        },
        {
          "name": "Presign File Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"dress-front.jpg\",\n  \"mimeType\": \"image/jpeg\",\n  \"fileSizeBytes\": 2048000,\n  \"resourceType\": \"GARMENT_PHOTO\"\n}"
            },
            "url": "{{baseUrl}}/public/files/presign",
            "description": "Phase 4."
          },
          "response": []
        }
      ]
    },
